# AI API ayarlari - bu dosyayi .env olarak kopyalayin ve gercek anahtari girin.
# .env otomatik olarak yuklenir (lib/env.js ve server.py).
#
# NOT: Cok kullanici icin onerilen yontem, anahtari uygulama icindeki
# "API Ayarlari" penceresinden girmektir (tarayici bazli, sunucuda saklanmaz).
# Buradaki degerler yalnizca sunucu geneli VARSAYILAN olarak kullanilir.
# OpenAI uyumlu her saglayici desteklenir (NVIDIA, OpenAI, OpenRouter, Groq,
# DeepSeek, EVREN/SSB, ozel adresler).
#
# NVIDIA NIM ornegi (varsayilan):
AI_API_KEY=
AI_API_BASE=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=nvidia/nemotron-3.5-super-vl-120b-a12b

# EVREN (SSB) ornegi - evren.ssyz.org.tr uzerinden evren_llm_... anahtari:
# AI_API_KEY=evren_llm_...
# AI_API_BASE=https://evren-llmapi.ssyz.org.tr/v1/chat/completions
# AI_MODEL=auto
